; Source-built G57 bounded live touchscreen qualification.
[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider=%Provider%
DriverVer=10/21/2026,0.0.57.0
CatalogFile=OpenG57.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTARM64.10.0...19041

[Models.NTARM64.10.0...19041]
%Description%=Install,Root\OnePlusOpenTouchG57

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%Disk%

[SourceDisksFiles]
OpenG57.sys=1

[Install.NT]
CopyFiles=DriverCopy

[DriverCopy]
OpenG57.sys

[Install.NT.HW]
AddReg=Hardware

[Hardware]
HKR,,"LowerFilters",0x00010000,"vhf"
HKR,,"Security",0x00000000,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[Install.NT.Services]
AddService=OpenG57,0x00000002,Service

[Service]
DisplayName=%Description%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\OpenG57.sys

[Install.NT.Wdf]
KmdfService=OpenG57,Wdf

[Wdf]
KmdfLibraryVersion=1.15

[Strings]
Provider="OnePlus Open Private Lab"
Description="OnePlus Open G57 Bounded Live Touch Qualification"
Disk="OnePlus Open G57 source-built test package"
