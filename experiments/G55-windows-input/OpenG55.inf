; Source-built G55 test touchscreen foundation; no controller or disk access.
[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider=%Provider%
DriverVer=10/21/2026,0.0.55.0
CatalogFile=OpenG55.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTARM64.10.0...19041

[Models.NTARM64.10.0...19041]
%Description%=Install,Root\OnePlusOpenTouchG55

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%Disk%

[SourceDisksFiles]
OpenG55.sys=1

[Install.NT]
CopyFiles=DriverCopy

[DriverCopy]
OpenG55.sys

[Install.NT.HW]
AddReg=Hardware

[Hardware]
HKR,,"LowerFilters",0x00010000,"vhf"
HKR,,"Security",0x00000000,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[Install.NT.Services]
AddService=OpenG55,0x00000002,Service

[Service]
DisplayName=%Description%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\OpenG55.sys

[Install.NT.Wdf]
KmdfService=OpenG55,Wdf

[Wdf]
KmdfLibraryVersion=1.15

[Strings]
Provider="OnePlus Open Private Lab"
Description="OnePlus Open G55 Touch Replay Consumer Test"
Disk="OnePlus Open G55 source-built test package"
