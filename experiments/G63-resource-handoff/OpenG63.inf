; Source-built resource recorder. No SPB/GPIO/power functionality is declared.
[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=10/21/2026,0.0.63.0
CatalogFile=OpenG63.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTARM64.10.0...26100

[Models.NTARM64.10.0...26100]
%Description%=Install,ACPI\OPEN0063

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%Disk%

[SourceDisksFiles]
OpenG63.sys=1

[Install.NT]
CopyFiles=DriverCopy

[DriverCopy]
OpenG63.sys

[Install.NT.HW]
AddReg=Hardware

[Hardware]
HKR,,"Security",0x00000000,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[Install.NT.Services]
AddService=OpenG63,0x00000002,Service

[Service]
DisplayName=%Description%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\OpenG63.sys

[Install.NT.Wdf]
KmdfService=OpenG63,Wdf

[Wdf]
KmdfLibraryVersion=1.15

[Strings]
Provider="OnePlus Open Private Lab"
Description="OnePlus Open G63 GENI Resource Handoff Recorder"
Disk="OnePlus Open G63 source-built test package"
