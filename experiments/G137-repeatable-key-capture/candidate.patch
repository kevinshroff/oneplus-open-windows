+	if status["kernel_build"] != uint32(26300) || status["processors"] != uint32(8) || status["IRQL"] != uint32(0) || status["firmware_match"] != uint32(1) || status["firmware_bytes"] != uint32(576) {
+		panic("qualified platform required")
