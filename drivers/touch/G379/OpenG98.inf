; Source-built G98 bounded live touchscreen qualification.
[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider=%Provider%
DriverVer=10/28/2026,0.0.98.379
CatalogFile=OpenG98.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTARM64.10.0...19041

[Models.NTARM64.10.0...19041]
%Description%=Install,Root\OnePlusOpenTouchG98

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%Disk%

[SourceDisksFiles]
OpenG98.sys=1

[Install.NT]
CopyFiles=DriverCopy

[DriverCopy]
OpenG98.sys

[Install.NT.HW]
AddReg=Hardware

[Hardware]
HKR,,"LowerFilters",0x00010000,"vhf"
HKR,,"Security",0x00000000,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[Install.NT.Services]
AddService=OpenG98,0x00000002,Service

[Service]
DisplayName=%Description%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\OpenG98.sys

[Install.NT.Wdf]
KmdfService=OpenG98,Wdf

[Wdf]
KmdfLibraryVersion=1.15

[Strings]
Provider="OnePlus Open Private Lab"
Description="OnePlus Open G98 Inner Touch"
Disk="OnePlus Open G98 source-built test package"
