[Version]
Signature   = "$WINDOWS NT$"
Class       = Battery
ClassGuid   = {72631e54-78a4-11d0-bcf7-00aa00b7b32a}
Provider    = %MfgName%
CatalogFile = OpenBattery.cat
DriverVer   = 11/26/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
OpenBattery.sys = 1,,

[Manufacturer]
%MfgName% = Standard,NTARM64

[Standard.NTARM64]
%DeviceDesc% = OpenBattery_Install, ROOT\OPENBATTERY

[OpenBattery_Install.NT]
CopyFiles = Drivers_Dir

[Drivers_Dir]
OpenBattery.sys

[OpenBattery_Install.NT.Services]
AddService = OpenBattery, 0x00000002, OpenBattery_Service_Inst

[OpenBattery_Service_Inst]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\OpenBattery.sys

[Strings]
MfgName     = "OnePlus Open Windows Project"
DiskName    = "OpenBattery Installation Disk"
DeviceDesc  = "OnePlus Open Dual-Cell Battery"
ServiceDesc = "OnePlus Open Battery Class Minidriver"
