+                 g_topazVp[0], g_topazVp[1], g_topazVp[2], g_topazVp[3], g_topazRsScissor ? 1 : 0,
+                 g_topazSc[0], g_topazSc[1], g_topazSc[2], g_topazSc[3], srv);
+}
